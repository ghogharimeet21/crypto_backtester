        "strategy_model": "\"\"\"\nstrategy_model for the RSI threshold dynamic strategy.\n\nSent as the \"strategy_model\" field to /engine/execute, where it's exec()'d\ninto the RUNTIME namespace before strategy_json is used to build an\ninstance. The class must be named Strategy \u2014 that's the name /execute\nlooks up after exec'ing this code (see engine/routes.py -> execute()).\n\nMirrors the __init__(self, request_json: dict) convention used by\nSmaCrossoverStrategy / TrendConfluenceStrategy.\n\"\"\"\n\n\nclass Strategy:\n    \"\"\"\n    Config object built from strategy_json.\n\n    Expected JSON:\n    {\n        \"symbol\":          \"BTCUSDT\",\n        \"timeframe\":       300,     # seconds \u2014 300 = 5-min candles\n        \"start_date\":      20260101,\n        \"end_date\":        20260101,\n        \"rsi_period\":      14,\n        \"rsi_oversold\":    30,\n        \"rsi_overbought\":  70,\n        \"target\":          500,     # points away from entry\n        \"stop_loss\":       200      # points away from entry\n    }\n    \"\"\"\n\n    def __init__(self, request_json: dict):\n        self.symbol: str = request_json[\"symbol\"]\n        self.timeframe: int = int(request_json[\"timeframe\"])\n        self.start_date: int = int(request_json[\"start_date\"])\n        self.end_date: int = int(request_json[\"end_date\"])\n\n        self.rsi_period: int = int(request_json[\"rsi_period\"])\n        self.rsi_oversold: int | float = float(request_json[\"rsi_oversold\"])\n        self.rsi_overbought: int | float = float(request_json[\"rsi_overbought\"])\n\n        self.target: int | float = float(request_json[\"target\"])\n        self.stop_loss: int | float = float(request_json[\"stop_loss\"])",
        "helper_utils": "\"\"\"\nhelper_utils for the RSI threshold dynamic strategy.\n\nSent as the \"helper_utils\" field to /engine/execute, exec'd into the\nRUNTIME namespace first (before strategy_model and strategy_code), so any\nnames defined here are available to both of those.\n\"\"\"\n\n\ndef crossed_below(prev_value, value, threshold):\n    return prev_value is not None and prev_value >= threshold and value < threshold\n\n\ndef crossed_above(prev_value, value, threshold):\n    return prev_value is not None and prev_value <= threshold and value > threshold",
        "strategy_code": "\"\"\"\nstrategy_code for the RSI threshold dynamic strategy.\n\nSent as the \"strategy_code\" field to /engine/execute. Exec'd last, after\nhelper_utils and strategy_model, into the same RUNTIME namespace \u2014 so\nTrade, OrderSide, ExitReason, BacktestResult, seconds_to_hms, meta_data,\nand crossed_below/crossed_above (from helper_utils) are all already bare\nnames here with no import lines needed. SOURCE is the one RUNTIME doesn't\ncarry, so it's imported here like normal.\n\n/execute calls execute(strategy) with a Strategy instance already built\nfrom strategy_json \u2014 that's why this takes `strategy` as an argument\ninstead of hardcoding symbol/dates/periods like the original smoke-test\nversion did.\n\nRules\n-----\n- RSI crosses below strategy.rsi_oversold   -> BUY\n- RSI crosses above strategy.rsi_overbought -> SELL/EXIT\n- Only one open trade at a time\n- Stoploss/target checked using candle high/low, stoploss wins on same-bar hits\n- No forced close at end of range \u2014 the trade is returned as open\n\"\"\"\n\nfrom data.indicators.enums import SOURCE\n\n\ndef execute(strategy):\n    symbol = strategy.symbol\n    tf = strategy.timeframe\n    start_date = strategy.start_date\n    end_date = strategy.end_date\n\n    rsi_period = strategy.rsi_period\n    rsi_oversold = strategy.rsi_oversold\n    rsi_overbought = strategy.rsi_overbought\n\n    target = strategy.target\n    stop_loss = strategy.stop_loss\n\n    meta_data.meta_utils.fill_relevant_quotes(symbol, start_date, end_date, tf)\n\n    meta_data.indicators.compute_rsi(symbol, tf, rsi_period, start_date, end_date)\n\n    quotes = meta_data.meta_utils.get_quotes_series(symbol, start_date, end_date, tf)\n\n    if not quotes:\n        return {\"status\": \"success\", \"result\": BacktestResult([]).to_dict()}\n\n    trades = []\n    open_trade = None\n    prev_rsi = None\n\n    def build_trade(entry_date, entry_time, entry_price):\n        return Trade(\n            entry_date=entry_date,\n            entry_time=entry_time,\n            entry_price=entry_price,\n            order_side=OrderSide.BUY,\n            quantity=1,\n            target=target,\n            stop_loss=stop_loss,\n        )\n\n    for quote in quotes:\n        date, time = quote.date, quote.time\n\n        rsi = meta_data.indicators.get_rsi(symbol, tf, SOURCE.CLOSE, rsi_period, date, time)\n\n        if rsi is None:\n            prev_rsi = rsi\n            continue\n\n        crossed_below_oversold = crossed_below(prev_rsi, rsi, rsi_oversold)\n        crossed_above_overbought = crossed_above(prev_rsi, rsi, rsi_overbought)\n\n        closed_this_bar = False\n\n        if open_trade is not None:\n            stoploss_hit = (\n                open_trade.stop_loss_price is not None\n                and quote._low <= open_trade.stop_loss_price\n            )\n            target_hit = (\n                open_trade.target_price is not None\n                and quote._high >= open_trade.target_price\n            )\n\n            if stoploss_hit:\n                open_trade.close(\n                    exit_date=date,\n                    exit_time=time,\n                    exit_price=open_trade.stop_loss_price,\n                    exit_reason=ExitReason.STOPLOSS,\n                )\n                trades.append(open_trade)\n                open_trade = None\n                closed_this_bar = True\n            elif target_hit:\n                open_trade.close(\n                    exit_date=date,\n                    exit_time=time,\n                    exit_price=open_trade.target_price,\n                    exit_reason=ExitReason.TARGET,\n                )\n                trades.append(open_trade)\n                open_trade = None\n                closed_this_bar = True\n            elif crossed_above_overbought:\n                open_trade.close(\n                    exit_date=date,\n                    exit_time=time,\n                    exit_price=quote._close,\n                    exit_reason=ExitReason.SIGNAL,\n                )\n                trades.append(open_trade)\n                open_trade = None\n                closed_this_bar = True\n\n        if open_trade is None and not closed_this_bar and crossed_below_oversold:\n            open_trade = build_trade(date, time, quote._close)\n            print(\n                f\"BUY {symbol} @ {quote._close:.2f} date={date} \"\n                f\"time={seconds_to_hms(time)} rsi={rsi:.1f}\"\n            )\n\n        prev_rsi = rsi\n\n    result = BacktestResult(trades)\n\n    return {\n        \"status\": \"success\",\n        \"trades_found\": len(trades),\n        \"result\": result.to_dict(),\n    }"
    },
